{
  "version": 2,
  "name": "revival",
  "buildCommand": "npm run build --workspace=packages/frontend",
  "outputDirectory": "packages/frontend/dist",
  "installCommand": "npm ci",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- packages/frontend/",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
